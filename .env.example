# Google Maps JavaScript API key with the Maps JavaScript API enabled.
# Required for the Google Maps provider to render the map.
VITE_GOOGLE_MAPS_API_KEY=KEY_HERE

# (Optional) Google Cloud Map ID. Required only if you want Advanced Markers
# (the rich pin UI). Without it, Yahapp falls back to legacy markers automatically.
# Create one at: https://console.cloud.google.com/google/maps-apis/studio/maps
VITE_GOOGLE_MAPS_MAP_ID=ID_HERE

# (Optional) Enable debug mode. Shows a debug sidebar on desktop with tools
# to mock device coordinates and orientation.
VITE_DEBUG_MODE=false
